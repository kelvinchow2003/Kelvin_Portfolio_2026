# Copy to .env.local for local development, and add the same variables in
# your host's dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# The deployed address, used for link previews, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Message Board email delivery through Resend (https://resend.com).
# Without these the form falls back to opening the visitor's mail app.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain you've verified with Resend.
CONTACT_FROM_EMAIL=
